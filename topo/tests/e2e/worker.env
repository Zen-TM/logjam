# The topo worker's env in CI's topo-e2e job: the MiniStack task definition is
# built from it, and it is the docker --env-file of the check and relaunch
# containers. JOB_ID comes from the RunTask override or -e, never from here.
# The first block mirrors the topo_worker task definition in
# infra/terraform/envs/prod/ecs.tf, environment and secrets alike: the job
# fails when that definition names a variable this file lacks. Hosts are the
# job's containers on its no-internet network.
AWS_REGION=ap-southeast-2
DB_HOST=postgres
DB_NAME=logjam
DB_PORT=5432
DB_USER=logjam
DB_PASSWORD=logjam
FRONTEND_URL=http://localhost:5173/
GDAL_DISABLE_READDIR_ON_OPEN=EMPTY_DIR
EMAIL_FROM=noreply@example.com
# Empty: email is a no-op without it (email_send.py).
RESEND_API_KEY=
S3_BUCKET_TOPO=logjam-topo-local
SVTM_FORMATION_S3_PATH=s3://logjam-topo-local/svtm/svtm_formation.tif

# CI only. Prod reads the fire raster from its default path in the prod bucket.
FIRE_HISTORY_S3_PATH=s3://logjam-topo-local/fire/fire_history_year.tif
OVERPASS_ENDPOINTS=http://overpass:8000/api/interpreter
# MiniStack, for boto3 (AWS_ENDPOINT_URL) and for GDAL's /vsis3/ (the rest).
AWS_ENDPOINT_URL=http://ministack:4566
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test
AWS_S3_ENDPOINT=ministack:4566
AWS_HTTPS=NO
AWS_VIRTUAL_HOSTING=FALSE
