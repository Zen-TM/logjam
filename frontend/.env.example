# Frontend environment variables template.
# Copy to frontend/.env and fill in values.
# For fully local dev with fake auth, use the values below as-is.

# API base URL
VITE_API_URL=http://localhost:8080

# Auth mode: "fake" skips Cognito (use for make dev). "cognito" uses real Cognito.
VITE_AUTH_MODE=fake

# Cognito config (only needed when VITE_AUTH_MODE=cognito)
VITE_COGNITO_USER_POOL_ID=
VITE_COGNITO_CLIENT_ID=

# Optional: serve dev maps from MiniStack instead of the prod CDN. Unset, the
# archives come from the prod CDN. Set, upload each archive under master/ in the
# local topo bucket first (README, Local Development); the vector basemap has no
# local source, so it 404s and the map has no base layer.
# DEV_MASTER_URL=http://127.0.0.1:4566/logjam-topo-local
#
# Or try one new file on the real basemap: run `node scripts/dev-master.mjs`,
# which serves what you uploaded and takes the rest from the prod CDN.
# DEV_MASTER_URL=http://127.0.0.1:4567
