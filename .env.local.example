# Copy this file to .env.local and fill in values where indicated.
# .env.local is gitignored and never committed.

# ── Auth mode ─────────────────────────────────────────────────────────────────
# "fake" = no Cognito, instant login as the seeded alice user (default for make dev)
# "cognito" = real Cognito dev pool (required for make dev-snapshot)
AUTH_MODE=fake

# UUID sub for the fake user — must match a cognitoId in the seed data.
# alice=fake-alice-sub  bob=fake-bob-sub  carol=fake-carol-sub
FAKE_USER_SUB=fake-alice-sub

# ── Cognito (only needed when AUTH_MODE=cognito) ───────────────────────────────
COGNITO_USER_POOL_ID=
COGNITO_CLIENT_ID=
COGNITO_REGION=ap-southeast-2

# ── DB (used by API when run on host) ─────────────────────────────────────────
DATABASE_URL=postgresql://logjam:logjam@localhost:5432/logjam

# ── LocalStack (used by API when run on host) ─────────────────────────────────
AWS_ENDPOINT_URL=http://localhost:4566
AWS_REGION=ap-southeast-2
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test

# ── S3 / SQS bucket names (LocalStack) ────────────────────────────────────────
S3_BUCKET_MEDIA=logjam-media-local
S3_BUCKET_TOPO=logjam-topo-local
SQS_QUEUE_URL=http://localhost:4566/000000000000/logjam-topo-jobs-local

# ── Other API config ──────────────────────────────────────────────────────────
PORT=8080
NODE_ENV=development
CORS_ORIGIN=http://localhost:5173
SES_FROM_EMAIL=noreply@local
TOPO_CDN_BASE_URL=http://localhost:4566/logjam-topo-local

# ── Snapshot (only needed when running make snapshot) ─────────────────────────
# DATABASE_URL_PROD=postgresql://...
