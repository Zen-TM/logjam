# Dependencies
node_modules/

# Build output
dist/
# TypeScript incremental build cache (emitted by `tsc -b`)
*.tsbuildinfo

# Python bytecode
__pycache__/
*.pyc

# Environment files — never commit secrets
.env
.env.local
.env.*.local
*.env.local
# Terraform var files may carry secrets (e.g. TF_VAR_resend_api_key overrides)
*.tfvars
*.auto.tfvars

# Sanitised prod DB dumps written by `make snapshot`
snapshots/*.sql

# Map archives are large and regenerable — never committed
*.pmtiles

# Claude Code: personal instructions, local settings, and worktrees (a worktree
# committed by mistake is a second copy of the repo)
CLAUDE.local.md
.claude/settings.local.json
.claude/worktrees/

# Screenshots and snapshots from the Playwright MCP server declared in .mcp.json
.playwright-mcp/

# Personal skills: anything named `<name>.local/` is yours alone
/.claude/skills/*.local/

# Scratch space: everything under private/ stays on your machine (see
# private/.gitignore). Machine-specific ignores belong in .git/info/exclude.
