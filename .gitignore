# Personal scratch data — datasets, screenshots, plans, one-off exports
/private/

# Claude Code: skills + project settings are checked in; local overrides aren't
.claude/settings.local.json

.playwright-mcp/
repomix-output.xml

# Audit skill outputs (local-only)
docs/audits/
.audit-tmp/

# Python bytecode
__pycache__/
*.pyc

# Dependencies
node_modules/

# Build output
dist/
# TypeScript incremental build cache (emitted by `tsc -b`)
*.tsbuildinfo

# Environment files — never commit secrets
.env
.env.local
.env.*.local
# Terraform var files may carry secrets (e.g. TF_VAR_resend_api_key overrides)
*.tfvars
*.auto.tfvars

# Local dev environment
snapshots/*.sql
localstack-data/
postgres-data/

# Personal, un-committed dev setup (syncthing repo mirror, local CLAUDE.md overrides)
CLAUDE.local.md
.stfolder/
.stignore
