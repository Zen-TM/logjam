.claude
.playwright-mcp/
repomix-output.xml

# Audit skill outputs (local-only)
docs/audits/
.audit-tmp/

# Python bytecode
__pycache__/
*.pyc

# Dependencies
node_modules/

# Build output
dist/
# TypeScript incremental build cache (emitted by `tsc -b`)
*.tsbuildinfo

# Environment files — never commit secrets
.env
.env.local
.env.*.local
# Terraform var files may carry secrets (e.g. TF_VAR_resend_api_key overrides)
*.tfvars
*.auto.tfvars

# Local dev environment
snapshots/*.sql
localstack-data/
postgres-data/
