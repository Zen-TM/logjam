{
  "expo": {
    "name": "Logjam",
    "slug": "logjam-mobile",
    "owner": "logjamnsw",
    "scheme": "logjam",
    "version": "0.1.0",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "bundleIdentifier": "com.logjamnsw.mobile",
      "supportsTablet": false,
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "UIBackgroundModes": [
          "location"
        ]
      }
    },
    "android": {
      "package": "com.logjamnsw.mobile",
      "allowBackup": false,
      "edgeToEdgeEnabled": true,
      "intentFilters": [
        {
          "action": "VIEW",
          "category": [
            "DEFAULT"
          ],
          "data": [
            {
              "mimeType": "application/pdf"
            },
            {
              "mimeType": "application/gpx+xml"
            },
            {
              "mimeType": "application/vnd.google-earth.kml+xml"
            },
            {
              "mimeType": "application/vnd.google-earth.kmz"
            },
            {
              "mimeType": "application/geo+json"
            }
          ]
        }
      ]
    },
    "plugins": [
      "expo-dev-client",
      "expo-asset",
      "expo-font",
      [
        "@maplibre/maplibre-react-native",
        {
          "android": {
            "nativeVariant": "vulkan",
            "nativeVersion": "12.3.1"
          }
        }
      ],
      "expo-secure-store",
      "@sentry/react-native",
      "expo-sqlite",
      [
        "expo-location",
        {
          "isAndroidForegroundServiceEnabled": true,
          "locationWhenInUsePermission": "Logjam shows your position on the map and records tracks you start."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Logjam attaches photos from your library to canyons and trips.",
          "cameraPermission": "Logjam lets you take photos to attach to canyons and trips."
        }
      ],
      "expo-video",
      "./plugins/withCameraCapture"
    ],
    "extra": {
      "eas": {
        "projectId": "8008fb2a-ea4c-4cc1-a637-97eb64500cb7"
      }
    }
  }
}
