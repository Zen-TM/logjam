{
  "name": "@logjam/mobile",
  "version": "0.1.0",
  "private": true,
  "license": "AGPL-3.0-only",
  "main": "index.ts",
  "scripts": {
    "start": "expo start --dev-client",
    "android": "expo run:android",
    "dev:android": "./scripts/dev-android.sh",
    "ios": "expo run:ios",
    "pretypecheck": "npm --prefix ../shared run build",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "update:preview": "eas update --branch preview --environment preview --private-key-path keys/private-key.pem",
    "update:production": "eas update --branch production --environment production --private-key-path keys/private-key.pem",
    "eas-build-post-install": "cd ../shared && npm ci && npm run build",
    "postinstall": "patch-package"
  },
  "expo": {
    "autolinking": {
      "android": {
        "buildFromSource": [
          "expo-location"
        ]
      }
    },
    "install": {
      "exclude": [
        "@sentry/react-native",
        "react-native-get-random-values"
      ]
    }
  },
  "dependencies": {
    "@aws-amplify/react-native": "^1.3.3",
    "@expo/vector-icons": "^15.0.3",
    "@logjam/shared": "file:../shared",
    "@maplibre/maplibre-react-native": "^11.4.0",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-native-community/netinfo": "12.0.1",
    "@react-navigation/bottom-tabs": "^7.19.2",
    "@react-navigation/native": "^7.3.13",
    "@react-navigation/native-stack": "^7.19.2",
    "@sentry/react-native": "~8.28.0",
    "aws-amplify": "^6.22.1",
    "expo": "^57.0.9",
    "expo-asset": "~57.0.18",
    "expo-constants": "~57.0.20",
    "expo-crypto": "~57.0.3",
    "expo-dev-client": "~57.0.19",
    "expo-document-picker": "~57.0.3",
    "expo-file-system": "~57.0.7",
    "expo-font": "~57.0.4",
    "expo-image-manipulator": "~57.0.20",
    "expo-image-picker": "~57.0.20",
    "expo-keep-awake": "~57.0.2",
    "expo-linear-gradient": "~57.0.2",
    "expo-local-authentication": "~57.0.3",
    "expo-location": "~57.0.20",
    "expo-media-library": "~57.0.5",
    "expo-notifications": "~57.0.21",
    "expo-secure-store": "~57.0.4",
    "expo-sensors": "~57.0.3",
    "expo-splash-screen": "~57.0.9",
    "expo-sqlite": "~57.0.3",
    "expo-status-bar": "~57.0.1",
    "expo-task-manager": "~57.0.21",
    "expo-updates": "~57.0.24",
    "expo-video": "~57.0.5",
    "expo-video-thumbnails": "~57.0.2",
    "fflate": "^0.8.3",
    "react": "19.2.3",
    "react-native": "0.86.3",
    "react-native-edge-to-edge": "1.6.2",
    "react-native-get-random-values": "^2.0.0",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-url-polyfill": "^4.0.0"
  },
  "devDependencies": {
    "@types/node": "^24.19.0",
    "@types/react": "~19.2.10",
    "babel-preset-expo": "~57.0.0",
    "eslint": "^9.0.0",
    "eslint-config-expo": "~57.0.2",
    "patch-package": "^8.0.1",
    "typescript": "~6.0.3",
    "vitest": "^4.1.8"
  },
  "overrides": {
    "brace-expansion@<1.1.18": "^1.1.18",
    "brace-expansion@>=2.0.0 <2.1.4": "^2.1.4",
    "brace-expansion@>=4.0.0 <5.0.8": "^5.0.8",
    "js-yaml@>=3.0.0 <3.15.1": "^3.15.1",
    "js-yaml@>=4.0.0 <4.3.1": "^4.3.1",
    "nanoid": "^3.3.17",
    "postcss": "^8.5.26",
    "xcode": {
      "uuid": "^11.1.1"
    }
  }
}
