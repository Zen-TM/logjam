{
  "name": "@logjam/mobile",
  "version": "0.1.0",
  "private": true,
  "license": "AGPL-3.0-only",
  "main": "index.ts",
  "scripts": {
    "start": "expo start --dev-client",
    "android": "expo run:android",
    "dev:android": "./scripts/dev-android.sh",
    "ios": "expo run:ios",
    "pretypecheck": "npm --prefix ../shared run build",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "update:preview": "scripts/check-eas-env.sh preview && eas update --branch preview --environment preview --private-key-path keys/private-key.pem",
    "update:production": "node scripts/check-production-update.js && scripts/check-eas-env.sh production && eas update --branch production --environment production --private-key-path keys/private-key.pem",
    "promote:production": "sh -c 'node scripts/check-production-update.js promote \"$@\" && eas update:republish --destination-branch production --private-key-path keys/private-key.pem \"$@\"' sh",
    "eas-build-post-install": "cd ../shared && npm ci && npm run build",
    "postinstall": "patch-package"
  },
  "expo": {
    "autolinking": {
      "android": {
        "buildFromSource": [
          "expo-location"
        ]
      }
    },
    "doctor": {
      "reactNativeDirectoryCheck": {
        "exclude": [
          "logjam-download-service",
          "logjam-pdf-renderer",
          "logjam-sensors"
        ]
      }
    }
  },
  "dependencies": {
    "@expo/vector-icons": "^15.0.3",
    "@logjam/shared": "file:../shared",
    "@maplibre/maplibre-react-native": "^11.5.1",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-native-community/netinfo": "12.0.1",
    "@react-navigation/bottom-tabs": "^7.20.0",
    "@react-navigation/native": "^7.3.13",
    "@react-navigation/native-stack": "^7.20.0",
    "@sentry/react-native": "~8.28.0",
    "@zoontek/react-native-navigation-bar": "^2.0.2",
    "expo": "~58.0.22",
    "expo-asset": "~58.0.19",
    "expo-auth-session": "~58.0.16",
    "expo-constants": "~58.0.14",
    "expo-crypto": "~58.0.7",
    "expo-dev-client": "~58.0.18",
    "expo-document-picker": "~58.0.4",
    "expo-file-system": "~58.0.13",
    "expo-font": "~58.0.11",
    "expo-image-manipulator": "~58.0.16",
    "expo-image-picker": "~58.0.10",
    "expo-keep-awake": "~58.0.3",
    "expo-linear-gradient": "~58.0.3",
    "expo-local-authentication": "~58.0.2",
    "expo-location": "~58.0.20",
    "expo-media-library": "~58.0.13",
    "expo-notifications": "~58.1.7",
    "expo-secure-store": "~58.0.2",
    "expo-sensors": "~58.0.4",
    "expo-splash-screen": "~58.0.12",
    "expo-sqlite": "~58.0.15",
    "expo-task-manager": "~58.0.13",
    "expo-updates": "~58.0.20",
    "expo-video": "~58.0.13",
    "expo-video-thumbnails": "~58.0.2",
    "expo-web-browser": "~58.0.7",
    "fflate": "^0.8.3",
    "react": "19.3.0",
    "react-native": "0.88.1",
    "react-native-get-random-values": "^2.1.0",
    "react-native-safe-area-context": "~5.10.1",
    "react-native-screens": "~4.30.1",
    "react-native-url-polyfill": "^4.0.0"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@types/react": "~19.3.0",
    "babel-preset-expo": "~58.0.22",
    "eslint": "^9.0.0",
    "eslint-config-expo": "~58.0.4",
    "patch-package": "^8.0.1",
    "typescript": "~6.0.3",
    "vitest": "^4.1.12"
  },
  "overrides": {
    "brace-expansion@<1.1.18": "^1.1.18",
    "brace-expansion@>=2.0.0 <2.1.4": "^2.1.4",
    "brace-expansion@>=4.0.0 <5.0.8": "^5.0.8",
    "js-yaml@>=3.0.0 <3.15.1": "^3.15.1",
    "js-yaml@>=4.0.0 <4.3.1": "^4.3.1",
    "nanoid": "^3.3.17",
    "postcss": "^8.5.26",
    "xcode": {
      "uuid": "^11.1.1"
    }
  }
}
