{
  "name": "@logjam/mobile",
  "version": "0.1.0",
  "private": true,
  "license": "AGPL-3.0-only",
  "main": "index.ts",
  "scripts": {
    "start": "expo start --dev-client",
    "android": "expo run:android",
    "dev:android": "./scripts/dev-android.sh",
    "ios": "expo run:ios",
    "pretypecheck": "npm --prefix ../shared run build",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "update:preview": "eas update --branch preview --environment preview --private-key-path keys/private-key.pem",
    "update:production": "eas update --branch production --environment production --private-key-path keys/private-key.pem",
    "eas-build-post-install": "cd ../shared && npm ci && npm run build",
    "postinstall": "patch-package"
  },
  "expo": {
    "autolinking": {
      "android": {
        "buildFromSource": [
          "expo-location"
        ]
      }
    }
  },
  "dependencies": {
    "@aws-amplify/react-native": "^1.3.3",
    "@expo/vector-icons": "^15.0.3",
    "@logjam/shared": "file:../shared",
    "@maplibre/maplibre-react-native": "^11.4.0",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-native-community/netinfo": "11.5.2",
    "@react-navigation/bottom-tabs": "^7.19.2",
    "@react-navigation/native": "^7.3.13",
    "@react-navigation/native-stack": "^7.19.2",
    "@sentry/react-native": "~8.28.0",
    "aws-amplify": "^6.22.0",
    "expo": "^55.0.31",
    "expo-asset": "~55.0.20",
    "expo-constants": "~55.0.17",
    "expo-crypto": "~55.0.19",
    "expo-dev-client": "~55.0.40",
    "expo-document-picker": "~55.0.17",
    "expo-file-system": "~55.0.26",
    "expo-font": "~55.0.8",
    "expo-image-manipulator": "~55.0.21",
    "expo-image-picker": "~55.0.24",
    "expo-keep-awake": "~55.0.8",
    "expo-linear-gradient": "~55.0.18",
    "expo-local-authentication": "~55.0.18",
    "expo-location": "~55.1.14",
    "expo-media-library": "~55.0.21",
    "expo-notifications": "~55.0.27",
    "expo-secure-store": "~55.0.18",
    "expo-sensors": "~55.0.19",
    "expo-splash-screen": "~55.0.25",
    "expo-sqlite": "~55.0.20",
    "expo-status-bar": "~55.0.6",
    "expo-task-manager": "~55.0.20",
    "expo-updates": "~55.0.33",
    "expo-video": "~55.0.21",
    "expo-video-thumbnails": "~55.0.19",
    "fflate": "^0.8.3",
    "react": "19.2.0",
    "react-native": "0.83.10",
    "react-native-edge-to-edge": "1.6.2",
    "react-native-get-random-values": "^2.0.0",
    "react-native-safe-area-context": "~5.6.0",
    "react-native-screens": "~4.23.0",
    "react-native-url-polyfill": "^4.0.0"
  },
  "devDependencies": {
    "@types/react": "~19.2.10",
    "babel-preset-expo": "~55.0.8",
    "eslint": "^9.0.0",
    "eslint-config-expo": "~55.0.1",
    "patch-package": "^8.0.1",
    "typescript": "~5.9.2",
    "vitest": "^4.1.8"
  },
  "overrides": {
    "brace-expansion@<1.1.18": "^1.1.18",
    "brace-expansion@>=2.0.0 <2.1.4": "^2.1.4",
    "brace-expansion@>=4.0.0 <5.0.8": "^5.0.8",
    "js-yaml@>=3.0.0 <3.15.1": "^3.15.1",
    "js-yaml@>=4.0.0 <4.3.1": "^4.3.1",
    "nanoid": "^3.3.17",
    "postcss": "^8.5.26"
  }
}
