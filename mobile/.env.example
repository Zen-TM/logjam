# Mobile env — parallels the web VITE_* split. Copy to .env (gitignored) for
# local dev, or set per EAS build profile for cloud builds.
# NON-SECRET values only: Cognito pool/client IDs are public by design.

# Local dev points at the local API (make dev, port 8080). Prod points at
# https://api.logjamnsw.com. Simulator/emulator note: Android emulator reaches
# the host machine via 10.0.2.2, not localhost.
EXPO_PUBLIC_API_URL=http://10.0.2.2:8080

# cognito | fake — mirrors web AUTH_MODE. Local dev against fake auth uses the
# seeded user; real Cognito needs the prod pool IDs below.
EXPO_PUBLIC_AUTH_MODE=cognito

EXPO_PUBLIC_COGNITO_USER_POOL_ID=
EXPO_PUBLIC_COGNITO_CLIENT_ID=
