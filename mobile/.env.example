# Mobile env — parallels the web VITE_* split. Copy to .env (gitignored) for
# local dev, or set per EAS build profile for cloud builds.
# NON-SECRET values only: the OIDC issuer and client ID are public by design.

# Local dev points at the local API (make dev, port 8080). Prod points at
# https://api.logjamnsw.com. Simulator/emulator note: Android emulator reaches
# the host machine via 10.0.2.2, not localhost.
EXPO_PUBLIC_API_URL=http://10.0.2.2:8080

# Where Logjam Web lives: friend invite links made in Logjam GPS open there.
# Local dev is the Vite server from make dev. Prod is https://logjamnsw.com.
EXPO_PUBLIC_WEB_URL=http://localhost:5173

# oidc | fake — mirrors web VITE_AUTH_MODE. Local dev against fake auth uses the
# seeded user; oidc signs in through the issuer below.
EXPO_PUBLIC_AUTH_MODE=oidc
# fake is refused unless EXPO_PUBLIC_API_URL is loopback or a LAN address.

# Needed when EXPO_PUBLIC_AUTH_MODE is oidc. For Cognito the issuer is
# https://cognito-idp.<region>.amazonaws.com/<user-pool-id>. The app client must
# list logjam://auth (logjamdev://auth for the dev variant) as a callback and a
# sign-out URL.
EXPO_PUBLIC_OIDC_ISSUER=
EXPO_PUBLIC_OIDC_CLIENT_ID=

# Optional: where Logjam GPS fetches the map archives (master/*). Unset, it is
# the prod CDN. For MiniStack's topo bucket, reached over the adb reverse (4566)
# that `npm run dev:android` sets up, phone or emulator alike:
# EXPO_PUBLIC_TOPO_CDN_BASE_URL=http://127.0.0.1:4566/logjam-topo-local
