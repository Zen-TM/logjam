# Expo / native build artifacts
.expo/
web-build/
*.orig.*

# Native project dirs (managed by prebuild / EAS; regenerated, not committed
# until/unless the app ejects to bare workflow)
/ios
/android

# Local Expo modules: source is committed, Gradle build output is not
modules/*/android/build/

# Maestro E2E credentials (operator-provided test user)
e2e/.env.maestro

# FCM config: not a secret (it ships inside the APK) but it carries the Firebase
# project id + Android API key, and this repo is public. EAS builds read it from
# the GOOGLE_SERVICES_JSON file env variable — see app.config.ts.
google-services.json

# expo-updates code signing: the PRIVATE key lives only here, on the machine
# that publishes by hand, and in the main-only mobile-ota GitHub Environment
# (docs/decisions/0046-ota-hotfixes-publish-from-ci-on-a-labelled-merge.md).
# The certificate under certs/ is public by design — it is embedded in every
# build and is what the client checks signatures against — so it IS
# committed. Losing the private key means no further OTA updates until a new
# certificate ships in a store build; see ADR 0009.
keys/

# Metro / RN caches
.metro-health-check*
