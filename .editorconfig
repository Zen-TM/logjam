root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

[*.py]
indent_size = 4

[Makefile]
indent_style = tab

[*.md]
trim_trailing_whitespace = false

# The Excel export fixture is the CRLF + BOM case (.gitattributes keeps it
# byte-exact); an editor must not normalise it.
[frontend/src/csvImport/__fixtures__/corpus/places/excel-utf8-bom-crlf.csv]
charset = utf-8-bom
end_of_line = crlf
