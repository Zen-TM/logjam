# The rest of the API's environment: everything the container needs that the
# other files here do not set. These were set on the environment by hand, so a
# rebuilt environment came up without them. All non-secret: ids, names and
# URLs.
#
# A value set on the environment directly (console or CLI) outranks this
# file, so changing one here has no effect while a hand-set copy exists:
# remove the hand-set one first.
#
# The canonical values are `terraform output` in infra/terraform/envs/prod
# (outputs.tf). ECS_SUBNETS and ECS_SECURITY_GROUPS place the Fargate workers
# the API launches (src/lib/ecsRunTask.ts); the task-definition names are
# src/lib/env.ts defaults except the one below. Guard that every name here is
# one the API reads: src/ebEnvironment.unit.test.ts.
option_settings:
  aws:elasticbeanstalk:application:environment:
    NODE_ENV: production
    PORT: "8080"
    AUTH_MODE: cognito
    COGNITO_REGION: ap-southeast-2
    COGNITO_USER_POOL_ID: ap-southeast-2_x5zPhJXMk
    COGNITO_CLIENT_ID: 545ofbb8l9d1sl6ggbmk6oonn9
    CORS_ORIGIN: https://logjamnsw.com,https://www.logjamnsw.com
    S3_BUCKET_MEDIA: logjam-media
    S3_BUCKET_TOPO: logjam-topo-jobs
    TOPO_CDN_BASE_URL: https://logjamnsw.com
    ECS_CLUSTER: logjam-cluster
    ECS_TOPO_TASK_DEF: logjam-topo-worker
    ECS_SUBNETS: subnet-0f59b0845905891be,subnet-0c10e1438a8fd0231
    ECS_SECURITY_GROUPS: sg-0bd5e6621b5f3ec4b
