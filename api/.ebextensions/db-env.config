# DB connection parts (no password — boot.ts resolves it from Secrets Manager
# via DB_SECRET_ID, and services/prisma.ts re-resolves per connection so RDS
# rotation never requires a restart). Shipping these in the bundle makes the
# env change atomic with the application version that requires them.
# The RDS endpoint is VPC-bound (not publicly routable) and the secret NAME is
# not sensitive; the password itself never appears in config anywhere.
option_settings:
  aws:elasticbeanstalk:application:environment:
    DB_HOST: logjam-db.chwko8w4iz9p.ap-southeast-2.rds.amazonaws.com
    DB_PORT: "5432"
    DB_NAME: logjam
    DB_SECRET_ID: rds!db-6fa40c95-2bbc-4ee1-8f4e-de15c5abe3c4
