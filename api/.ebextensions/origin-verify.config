# CloudFront origin-verify (WAF-bypass guard, SEC). The EB API container resolves
# ORIGIN_VERIFY_SECRET from this Secrets Manager id at boot (src/boot.ts ->
# lib/resolveOriginVerifySecret.ts); the EB instance role (logjam-eb-role) needs
# GetSecretValue on it, granted in infra/terraform/envs/prod/origin_verify.tf —
# that grant MUST be applied before this config ships, or boot fails closed.
#
# ENFORCE starts "false": the app LOGS header mismatches (origin_verify_mismatch)
# without blocking, so the CloudFront header rollout can be confirmed. Once that
# log count sits at ~zero (all live traffic transits CloudFront, which sends the
# header), flip ORIGIN_VERIFY_ENFORCE to "true" and redeploy to start returning
# 403 for direct-to-EB requests. Flipping first = 403s for legitimate traffic.
# /health + /ready are exempt regardless (EB health checks hit the instance
# directly and carry no header).
option_settings:
  aws:elasticbeanstalk:application:environment:
    ORIGIN_VERIFY_SECRET_ID: logjam/origin-verify
    ORIGIN_VERIFY_ENFORCE: "false"
