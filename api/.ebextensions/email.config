# Email from the API's sweeps (src/services/email.ts). Prod sends through
# Resend's SMTP relay, so the username is literally `resend` and the password
# is the Resend API key, which src/boot.ts resolves from RESEND_SECRET_ID: EB
# has no secrets injection. The worker task definitions carry the same values
# (infra/terraform/envs/prod/ecs.tf).
option_settings:
  aws:elasticbeanstalk:application:environment:
    EMAIL_FROM: noreply@notifications.logjamnsw.com
    FRONTEND_URL: https://logjamnsw.com/
    RESEND_SECRET_ID: logjam/resend-api-key
    SMTP_HOST: smtp.resend.com
    SMTP_PORT: "465"
    SMTP_USER: resend
