# CloudWatch Logs retention for the EB API environment.
#
# RetentionInDays must equal local.operational_log_retention_days in
# infra/terraform/envs/prod/logging.tf, the one retention figure for every
# operational log, which privacy.html's Retention section states. Guard:
# api/src/logRetention.unit.test.ts.
#
# Set here rather than in Terraform because EB names and creates these groups
# (/aws/elasticbeanstalk/logjam-api-prod/*). RetentionInDays is EB-native and
# recreation-safe: EB reasserts it on every deploy and whenever it (re)creates
# the streamed groups, where a one-off console setting would be lost to a
# platform update or an environment rebuild.
#
# Applies on the next CI deploy. CI-owned per the EB convention (eb.tf pins
# ignore_changes=[setting]); .ebextensions is the canonical home for EB option
# settings in this repo (cf. db-env.config).
option_settings:
  # Instance log streaming: the container's stdout (pino API request logs) and
  # the platform's own logs, nginx's access log among them.
  aws:elasticbeanstalk:cloudwatch:logs:
    StreamLogs: true
    DeleteOnTerminate: false
    RetentionInDays: 14
  # Enhanced-health log streaming (environment-health.log). RetentionInDays only
  # bites when health streaming is enabled; harmless and consistent otherwise.
  aws:elasticbeanstalk:cloudwatch:logs:health:
    RetentionInDays: 14
