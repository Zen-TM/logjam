# CloudWatch Logs retention for the EB API environment (PRIV-001).
#
# The privacy policy (frontend/public/privacy.html, Retention section) states
# "API request logs expire automatically within 7 days". Nothing enforced that
# figure before — the EB-created log groups (/aws/elasticbeanstalk/logjam-api-prod/*)
# were at 7 days only by a one-off console setting (see scripts/set-log-retention.sh),
# which an EB platform update or environment rebuild could silently reset.
#
# RetentionInDays here is EB-native and recreation-safe: EB reasserts it on every
# deploy and whenever it (re)creates the streamed groups, so the published policy
# figure stays true without a Terraform import of the dynamically-named groups.
# (The three ECS *worker* log groups carry their 90-day retention via Terraform —
# infra/terraform/envs/prod/logging.tf — a different, IaC-managed surface.)
#
# Applies on the next CI deploy. CI-owned per the EB convention (eb.tf pins
# ignore_changes=[setting]); .ebextensions is the canonical home for EB option
# settings in this repo (cf. db-env.config).
option_settings:
  # Instance / platform + application (Docker container stdout = pino API request
  # logs) log streaming. Groups already exist at 7 days; this locks the ceiling.
  aws:elasticbeanstalk:cloudwatch:logs:
    StreamLogs: true
    DeleteOnTerminate: false
    RetentionInDays: 7
  # Enhanced-health log streaming (environment-health.log). RetentionInDays only
  # bites when health streaming is enabled; harmless and consistent otherwise.
  aws:elasticbeanstalk:cloudwatch:logs:health:
    RetentionInDays: 7
