# S3 server access logs bucket for the monthly egress meter (lib/egressMeter.ts).
#
# Empty/absent disables the sweep, which also means the per-user egress cap
# never advances and therefore never bites — so this variable is what actually
# turns the limit on in prod. The bucket, its log-delivery policy and the
# logging config on logjam-media / logjam-topo-jobs are Terraform-managed
# (infra/terraform/envs/prod/s3.tf, s3_policies.tf).
#
# Non-secret (a bucket name). logjam-eb-role already has read on it via the
# AccessLogsRead statement in infra/terraform/envs/prod/iam.tf — apply that
# Terraform BEFORE this env change lands, or the sweep logs
# egress_sweep_failed on every reaper tick until it does.
option_settings:
  aws:elasticbeanstalk:application:environment:
    S3_BUCKET_ACCESS_LOGS: logjam-access-logs-620853681701
