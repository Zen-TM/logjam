# Unused since #513 removed the region-clip endpoint, and kept anyway:
# deleting an option setting here makes the deploy a CloudFormation update,
# which the deploy role's privacy Deny refuses today (#517). Delete this file
# in the change that fixes that.
option_settings:
  aws:elasticbeanstalk:application:environment:
    PROTOMAPS_ARCHIVE_URI: s3://logjam-topo-jobs/master/basemap/protomaps-nsw.pmtiles
