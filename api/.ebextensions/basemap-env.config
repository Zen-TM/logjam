# Protomaps basemap archive for the Stage 4a region-clip endpoint
# (POST /basemap/region-clip runs `pmtiles extract` against this URI; the
# binary is vendored in api/Dockerfile). s3:// so go-pmtiles range-reads
# through the instance role — logjam-eb-role already has read on
# logjam-topo-jobs. Non-secret. Shipping it here keeps the env change atomic
# with the application version that vendors the binary; until both land the
# endpoint 503s harmlessly.
option_settings:
  aws:elasticbeanstalk:application:environment:
    PROTOMAPS_ARCHIVE_URI: s3://logjam-topo-jobs/master/basemap/protomaps-nsw.pmtiles
