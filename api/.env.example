# API environment variables template.
# Copy to api/.env and fill in real values for local development against deployed AWS.
# For fully local dev, use make dev (sources .env.local from repo root instead).

# DB connection is composed at runtime from these discrete parts (lib/databaseUrl.ts).
# In prod, DB_PASSWORD is NOT set here — the EB container resolves DB_USER/DB_PASSWORD
# from the DB_SECRET_ID Secrets Manager secret at boot (see src/boot.ts).
DB_HOST=host
DB_PORT=5432
DB_NAME=logjam
DB_USER=user
DB_PASSWORD=password
# DB_SECRET_ID=arn:aws:secretsmanager:ap-southeast-2:xxxxxxxxxxxx:secret:logjam-db-xxxxxx
COGNITO_USER_POOL_ID=ap-southeast-2_xxxxxxxxx
COGNITO_CLIENT_ID=xxxxxxxxxxxxxxxxxxxxxxxxxx
COGNITO_REGION=ap-southeast-2
AWS_REGION=ap-southeast-2
S3_BUCKET_MEDIA=logjam-media
S3_BUCKET_TOPO=logjam-topo-jobs
SQS_QUEUE_URL=https://sqs.ap-southeast-2.amazonaws.com/xxxxxxxxxxxx/logjam-topo-jobs
ECS_CLUSTER=logjam-cluster
ECS_TOPO_TASK_DEF=logjam-topo-worker
ECS_SUBNETS=subnet-xxxxxxxxxxxxxxxxx
ECS_SECURITY_GROUPS=sg-xxxxxxxxxxxxxxxxx
SES_FROM_EMAIL=noreply@logjamnsw.com
TOPO_CDN_BASE_URL=https://your-cloudfront-domain.cloudfront.net
PORT=8080
NODE_ENV=development
CORS_ORIGIN=http://localhost:5173
