generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "debian-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
}

model User {
  id                   String              @id @default(uuid())
  cognitoId            String              @unique @map("cognito_id")
  username             String              @unique
  email                String              @unique
  uiPreferences        Json                @default("{}") @map("ui_preferences")
  vectorStyle          Json?               @map("vector_style")
  storageUsedBytes     BigInt              @default(0) @map("storage_used_bytes")
  storageQuotaBytes    BigInt              @default(5368709120) @map("storage_quota_bytes")
  monthlyTileQuota     Int                 @default(40) @map("monthly_tile_quota")
  consentedAt          DateTime?           @map("consented_at")
  consentVersion       String?             @map("consent_version")
  createdAt            DateTime            @default(now()) @map("created_at")
  sharedBy             CanyonShare[]       @relation("sharedBy")
  sharedWith           CanyonShare[]       @relation("sharedWith")
  canyons              Canyon[]
  receivedFriendships  Friendship[]        @relation("addressee")
  sentFriendships      Friendship[]        @relation("requester")
  media                Media[]
  notifications        Notification[]
  topoJobs             TopoJob[]
  topoExportJobs       TopoExportJob[]
  geoPdfJobs           GeoPdfJob[]
  tripLogs             TripLog[]
  geoPdfTemplates      GeoPdfTemplate[]
  topoTemplates        TopoTemplate[]
  deviceTokens         DeviceToken[]
  waypoints            Waypoint[]
  routes               Route[]
  syncTombstones       SyncTombstone[]
  directSharesSent     Share[]             @relation("directSharedBy")
  directSharesReceived Share[]             @relation("directSharedWith")
  fileSends            FileSend[]
  fileSendsReceived    FileSendRecipient[]

  @@map("users")
}

model Canyon {
  id               String           @id @default(uuid())
  ownerId          String           @map("owner_id")
  name             String
  altNames         String[]         @default([])
  latitude         Float
  longitude        Float
  numAbseils       Int?             @map("num_abseils")
  longestAbseil    Float?           @map("longest_abseil_m")
  notes            String?
  attributes       Json             @default("{}")
  createdAt        DateTime         @default(now()) @map("created_at")
  updatedAt        DateTime         @updatedAt @map("updated_at")
  forkedFromId     String?          @map("forked_from_id")
  ropeWikiId       Int?             @map("ropewiki_id")
  ropeWikiSnapshot Json?            @map("ropewiki_snapshot")
  vGrade           Int?             @map("v_grade")
  aGrade           Int?             @map("a_grade")
  commitment       Int?
  quality          Float?
  hours            Float?
  importKey        String?          @map("import_key")
  importBatchId    String?          @map("import_batch_id")
  shares           CanyonShare[]
  forkedFrom       Canyon?          @relation("CanyonForks", fields: [forkedFromId], references: [id], onDelete: SetNull)
  forks            Canyon[]         @relation("CanyonForks")
  owner            User             @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  tripLogLinks     TripLogCanyon[]
  waypointLinks    CanyonWaypoint[]
  /// @deprecated Back-relation for the pending canyon_id contract — see Waypoint.
  legacyWaypoints  Waypoint[]       @relation("LegacyWaypointCanyon")
  // At most one — the canyon's route slot. See Route.canyonId.
  route            Route?

  @@unique([ownerId, ropeWikiId])
  @@unique([ownerId, importKey])
  @@index([ownerId])
  @@index([ownerId, importBatchId])
  @@map("canyons")
}

model Notification {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  type      String
  payload   Json
  read      Boolean  @default(false)
  createdAt DateTime @default(now()) @map("created_at")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("notifications")
}

model TripLog {
  id            String          @id @default(uuid())
  userId        String          @map("user_id")
  date          DateTime
  displayName   String?         @map("display_name")
  types         String[]        @default([])
  notes         String?
  customFields  Json            @default("{}") @map("custom_fields")
  createdAt     DateTime        @default(now()) @map("created_at")
  // Delta-sync watermark (Stage 8). Backfilled from created_at by migration.
  updatedAt     DateTime        @updatedAt @map("updated_at")
  importKey     String?         @map("import_key")
  importBatchId String?         @map("import_batch_id")
  user          User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  canyons       TripLogCanyon[]

  @@unique([userId, importKey])
  @@index([userId])
  @@index([userId, importBatchId])
  @@map("trip_logs")
}

// Trip ↔ canyon many-to-many. `position` preserves the order the canyons were
// linked in; the derived trip title joins names in this order. Deleting a
// canyon or a trip removes only the link rows — trips outlive their canyons.
model TripLogCanyon {
  tripLogId String  @map("trip_log_id")
  canyonId  String  @map("canyon_id")
  position  Int
  tripLog   TripLog @relation(fields: [tripLogId], references: [id], onDelete: Cascade)
  canyon    Canyon  @relation(fields: [canyonId], references: [id], onDelete: Cascade)

  @@id([tripLogId, canyonId])
  @@index([canyonId])
  @@map("trip_log_canyons")
}

model Media {
  id             String   @id @default(uuid())
  ownerId        String   @map("owner_id")
  // Polymorphic link to a Canyon or TripLog. Deliberately NO database foreign
  // key on linkedId: a single column cannot FK two tables (the previous schema
  // declared FKs to both canyons and trip_logs, which made every insert fail).
  // Integrity is enforced in the route layer (ownership checks on attach) and
  // cleaned up explicitly on canyon/trip/account deletion.
  linkedType     String   @map("linked_type")
  linkedId       String   @map("linked_id")
  s3KeyThumbnail String?  @map("s3_key_thumbnail")
  s3KeyDisplay   String   @map("s3_key_display")
  mediaType      String   @map("media_type")
  filename       String
  fileSizeBytes  BigInt   @map("file_size_bytes")
  // Assigned only for track (GPX/KML) media from the shared TRACK_COLORS palette;
  // null for image/video. Drives the track card icon tint and map track layer.
  color          String?
  createdAt      DateTime @default(now()) @map("created_at")
  owner          User     @relation(fields: [ownerId], references: [id], onDelete: Cascade)

  @@index([ownerId])
  @@index([linkedType, linkedId])
  @@map("media")
}

model Friendship {
  id          String   @id @default(uuid())
  requesterId String   @map("requester_id")
  addresseeId String   @map("addressee_id")
  status      String   @default("pending")
  createdAt   DateTime @default(now()) @map("created_at")
  // Delta-sync watermark (Stage 8): status flips pending→accepted, so
  // createdAt alone can't carry the change. Backfilled from created_at.
  updatedAt   DateTime @updatedAt @map("updated_at")
  addressee   User     @relation("addressee", fields: [addresseeId], references: [id], onDelete: Cascade)
  requester   User     @relation("requester", fields: [requesterId], references: [id], onDelete: Cascade)

  @@unique([requesterId, addresseeId])
  @@index([addresseeId])
  @@map("friendships")
}

model CanyonShare {
  id           String   @id @default(uuid())
  canyonId     String   @map("canyon_id")
  sharedById   String   @map("shared_by_id")
  sharedWithId String   @map("shared_with_id")
  createdAt    DateTime @default(now()) @map("created_at")
  canyon       Canyon   @relation(fields: [canyonId], references: [id], onDelete: Cascade)
  sharedBy     User     @relation("sharedBy", fields: [sharedById], references: [id], onDelete: Cascade)
  sharedWith   User     @relation("sharedWith", fields: [sharedWithId], references: [id], onDelete: Cascade)

  @@index([canyonId])
  @@index([sharedWithId])
  @@index([sharedById])
  @@map("canyon_shares")
}

model TopoJob {
  id                  String    @id @default(uuid())
  userId              String    @map("user_id")
  status              String    @default("uploading")
  // status values: uploading | pending | processing | complete | failed
  name                String?
  footprint           Json?
  tileCount           Int?      @map("tile_count")
  estimatedSeconds    Int?      @map("estimated_seconds")
  layerOptions        Json?     @map("layer_options")
  vectorStyleSnapshot Json?     @map("vector_style_snapshot")
  // Auto-export config captured at submit (AutoExportSettings). When enabled,
  // the reaper queues a TopoExportJob once this job reaches "complete".
  autoExport          Json?     @map("auto_export")
  // Set by the reaper when it has handled the auto-export (queued it or
  // recorded why it couldn't). Dedup marker: a non-null value means "don't
  // auto-export again", so overlapping sweeps can't double-queue.
  autoExportedAt      DateTime? @map("auto_exported_at")
  s3InputKey          String?   @map("s3_input_key")
  s3OutputKeys        Json?     @map("s3_output_keys")
  // s3OutputKeys shape: { name: string, cogKey: string|null, pmtilesKey: string|null }[]
  // Raster layers (hillshade/vegetation/slope): cogKey set, pmtilesKey set (for in-app display).
  // Vector layers (contours/features): cogKey null, pmtilesKey set.
  // Composite + downloadable formats are produced on-demand by the export worker.
  outputBytes         BigInt?   @map("output_bytes")
  // Runtime instrumentation (set by the worker on completion from the
  // pipeline's metrics file). Feeds the adaptive runtime estimator — aggregate
  // timing/tile counts only, never canyon data.
  outputTileCount     Int?      @map("output_tile_count")
  pipelineMetrics     Json?     @map("pipeline_metrics")
  // pipelineMetrics shape: { schemaVersion, wallSeconds, phases: { key: seconds }, inputTileCount, outputTileCount, zoomMin, zoomMax }
  // Render progress heartbeat (written by the worker's heartbeat thread while
  // processing). lastProgressAt is the reaper's staleness anchor: a job is
  // reaped only when progress stalls (or an absolute ceiling is hit), so a
  // slow-but-healthy job that keeps advancing is never force-failed.
  renderTilesDone     Int?      @map("render_tiles_done")
  renderTilesTotal    Int?      @map("render_tiles_total")
  lastProgressAt      DateTime? @map("last_progress_at")
  errorMessage        String?   @map("error_message")
  // Set when the worker transitions the job to "processing". Distinguishes a
  // stale-stuck job from one that simply hasn't been picked up yet, so the
  // reaper can apply a separate (longer) timeout to actively-running jobs.
  startedAt           DateTime? @map("started_at")
  // Number of times /start has launched this job (currently at most 1 — the
  // status guard means a job can never re-enter /start; kept for forensics
  // and a possible future bounded re-launch).
  attemptCount        Int       @default(0) @map("attempt_count")
  // ARN of the Fargate task launched for this job (Design L2). Lets the
  // reaper and DELETE handler issue a best-effort ECS StopTask instead of
  // letting an orphaned task run to completion. Null until RunTask succeeds.
  ecsTaskArn          String?   @map("ecs_task_arn")
  createdAt           DateTime  @default(now()) @map("created_at")
  updatedAt           DateTime  @updatedAt @map("updated_at")
  user                User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([status])
  @@map("topo_jobs")
}

// On-demand export pipeline (Stage 2). One row per user-requested export of
// one (or more, future) completed TopoJob into a downloadable artefact. ECS
// task `logjam-topo-export-worker` consumes the row, produces the artefact,
// uploads it to s3://BUCKET/exports/{id}/{filename}, updates status, and
// emails the user. Replaces job-time composite MBTiles + stored MBTiles.
model TopoExportJob {
  id                  String    @id @default(uuid())
  userId              String    @map("user_id")
  sourceJobIds        String[]  @map("source_job_ids")
  // Single-element array for now; multi-job composites are a Stage 3 stretch.
  layers              String[]
  // Subset of TopoLayerKey (hillshade/vegetation/slope/contours/features).
  format              String
  // "mbtiles" | "geotiff" | "gpkg" | "geojson" | "gpx" (kmz deferred)
  bundling            String
  // "composite" | "per-layer"
  vectorStyleSnapshot Json      @map("vector_style_snapshot")
  // Snapshot of the source job's input tileCount at export creation. The
  // source TopoJob is deletable, so this can't be re-derived by join later —
  // it feeds the adaptive runtime estimator (aggregate size only, no canyon
  // data). Null on rows created before the column existed.
  sourceTileCount     Int?      @map("source_tile_count")
  // Adaptive processing-time estimate computed at create from past completed
  // exports of the same (format, bundling) — mirrors topo_jobs.estimated_seconds.
  estimatedSeconds    Int?      @map("estimated_seconds")
  status              String    @default("queued")
  // queued | running | completed | failed
  resultKey           String?   @map("result_key")
  resultBytes         BigInt?   @map("result_bytes")
  errorMessage        String?   @map("error_message")
  // Set when the export worker transitions the row to "running" — anchors the
  // reaper's running-timeout (mirrors topo_jobs.started_at).
  startedAt           DateTime? @map("started_at")
  // ARN of the Fargate task launched for this export (Design L2) — see
  // TopoJob.ecsTaskArn.
  ecsTaskArn          String?   @map("ecs_task_arn")
  createdAt           DateTime  @default(now()) @map("created_at")
  completedAt         DateTime? @map("completed_at")
  user                User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@map("topo_export_jobs")
}

// Async GeoPDF generation (mirrors TopoExportJob). Submitted via POST
// /geo-pdf, rendered by ECS task `logjam-geo-pdf-worker`
// (api/src/worker/geoPdfWorker.ts), uploaded to
// s3://BUCKET/exports/geo-pdf/{id}/logjam-export.pdf.
model GeoPdfJob {
  id                  String    @id @default(uuid())
  userId              String    @map("user_id")
  config              Json
  vectorStyleSnapshot Json      @map("vector_style_snapshot")
  // Adaptive processing-time estimate computed at create from past completed
  // GeoPDFs (size scalar recomputed from each row's retained config) —
  // mirrors topo_jobs.estimated_seconds.
  estimatedSeconds    Int?      @map("estimated_seconds")
  status              String    @default("queued")
  // queued | running | completed | failed
  resultKey           String?   @map("result_key")
  resultBytes         BigInt?   @map("result_bytes")
  errorMessage        String?   @map("error_message")
  // Set when the worker transitions the row to "running" — anchors the
  // reaper's running-timeout (mirrors topo_export_jobs.started_at).
  startedAt           DateTime? @map("started_at")
  // ARN of the Fargate task launched for this job (Design L2) — see
  // TopoExportJob.ecsTaskArn.
  ecsTaskArn          String?   @map("ecs_task_arn")
  createdAt           DateTime  @default(now()) @map("created_at")
  completedAt         DateTime? @map("completed_at")
  user                User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@map("geo_pdf_jobs")
}

model GeoPdfTemplate {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  name      String
  config    Json
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("geo_pdf_templates")
}

model TopoTemplate {
  id         String   @id @default(uuid())
  userId     String   @map("user_id")
  name       String
  config     Json
  autoExport Json?    @map("auto_export")
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("topo_templates")
}

// Field waypoints (Stage 7 mobile capture; web read/edit later). Owner-private:
// NEVER visible through canyon shares — sharing a canyon shares the canyon
// record, not your marked anchors/exits (privacy default; revisit only as an
// explicit per-waypoint opt-in feature).
// A marked point: a carpark, a campsite, an anchor, an exit. Authored on the
// phone, synced like canyons and trips.
//
// Visibility follows canyon-level MEDIA, exactly as a linked Route does: an
// UNLINKED waypoint is owner-private, and a waypoint linked to a shared canyon
// is part of that shared record (sharees may view and export, never edit).
// Unlike a route, the link is MANY-TO-MANY — one carpark legitimately serves
// several canyons off the same trailhead — which makes revocation the trap:
// a sharee can reach one waypoint through two shared canyons, so unlinking one
// of them must NOT revoke sight of it. Every visibility change therefore goes
// through lib/waypointLink.ts, never through an inline tombstone write.
// CONTRACT PENDING: `canyonId` below is DEAD to this code — every link now
// lives in CanyonWaypoint — but the column still exists so the previously
// deployed image keeps working through the deploy swap window (expand/contract,
// api/CLAUDE.md). Once a release carrying this comment is live, delete the
// field, the `canyon` relation, and Canyon.legacyWaypoints in a follow-up
// migration that drops the column.
model Waypoint {
  id          String           @id @default(uuid())
  ownerId     String           @map("owner_id")
  /// @deprecated Superseded by canyonLinks. Never read or written.
  canyonId    String?          @map("canyon_id")
  canyon      Canyon?          @relation("LegacyWaypointCanyon", fields: [canyonId], references: [id], onDelete: SetNull)
  name        String
  latitude    Float
  longitude   Float
  elevation   Float?
  // Client icon key; server treats as opaque (length-capped in the route).
  symbol      String?
  notes       String?
  // Free-text labels, same shape as TripLog.types: a seed vocabulary the user
  // extends by typing. No tag registry — the vocabulary IS the used values.
  tags        String[]         @default([])
  createdAt   DateTime         @default(now()) @map("created_at")
  updatedAt   DateTime         @updatedAt @map("updated_at")
  owner       User             @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  canyonLinks CanyonWaypoint[]

  @@index([ownerId])
  @@map("waypoints")
}

// Waypoint ↔ canyon, many-to-many. Cascade both ways deletes the LINK only:
// deleting a canyon leaves its waypoints alive and standalone (what the old
// SetNull canyon_id did), and deleting a waypoint leaves the canyon alone.
// No `position` — unlike TripLogCanyon nothing derives from the order here.
model CanyonWaypoint {
  canyonId   String   @map("canyon_id")
  waypointId String   @map("waypoint_id")
  canyon     Canyon   @relation(fields: [canyonId], references: [id], onDelete: Cascade)
  waypoint   Waypoint @relation(fields: [waypointId], references: [id], onDelete: Cascade)

  @@id([canyonId, waypointId])
  @@index([waypointId])
  @@map("canyon_waypoints")
}

// User-authored routes: the line the user drew, imported, or derived from a
// recording. Geometry is a vertex list ON THE ROW, not an S3 blob — a route is
// authored and edited in place, so it rides the delta-sync protocol like
// canyons/waypoints (offline draw → outbox → flush) and an edit is a PATCH.
// GPX/KML is an EXPORT format, not storage.
//
// NOT a recording. A recorded GPS track is an observation — immutable,
// timestamped, thousands of points — and keeps its own storage and its
// duration (shared/src/trackStats.ts). The only bridge is the deliberate
// "create route from recording" action, which simplifies to fit and leaves the
// recording intact.
//
// Visibility follows canyon-level MEDIA, not waypoints: a route LINKED to a
// shared canyon is part of that shared record (sharees may view and export,
// never edit); an unlinked route is owner-private.
model Route {
  id        String   @id @default(uuid())
  ownerId   String   @map("owner_id")
  // The canyon's single route slot. @unique enforces one-route-per-canyon in
  // the DB rather than app code (many NULLs are allowed, so unlinked routes
  // are unconstrained). Linking to an occupied canyon UNLINKS the incumbent,
  // which survives standalone — a link never destroys anything. SetNull keeps
  // routes alive when a canyon dies.
  canyonId  String?  @unique @map("canyon_id")
  name      String
  // From TRACK_COLORS (shared/src/media.ts), so routes and legacy track media
  // share one palette on the map. Assigned server-side.
  color     String
  // [[lon, lat], ...]. Shape and length enforced by validateRoutePayload
  // (shared/src/routeValidation.ts); MAX_ROUTE_POINTS is derived from the 1 MB
  // body limit divided by SYNC_PUSH_MAX_OPS — see that file's header before
  // raising it. No lengthM column: length is derived on read, and a stored one
  // goes stale the moment a vertex moves.
  points    Json
  // Indices into `points` marking the vertices the USER placed, as opposed to
  // the ones snapping filled in to follow a track. Nullable, and null is the
  // honest reading for a route drawn before snapping existed: without a record
  // we cannot know which vertices were chosen, so every one is treated as the
  // user's. Kept as indices rather than a second coordinate list so `points`
  // stays the single geometric truth and the two cannot disagree.
  anchors   Json?
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  owner     User     @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  canyon    Canyon?  @relation(fields: [canyonId], references: [id], onDelete: SetNull)

  @@index([ownerId])
  @@map("routes")
}

// Per-user deletion/visibility-revocation log for mobile delta sync (Stage 8).
// A row means "user X must remove entity (type,id) from any local mirror".
// Deliberately carries NO name/coords — ids only — so the table is log-safe
// and leaks nothing beyond what the recipient already legitimately knew
// existed. Rows older than SYNC_TOMBSTONE_TTL_MS are swept by the reaper; a
// client whose cursor predates the horizon is told to full-resync.
model SyncTombstone {
  id         BigInt   @id @default(autoincrement())
  // Visibility scope: who must forget. Cascade wipes the deleted user's own
  // tombstones on account delete; fan-out rows written FOR other users
  // (their sharees) belong to those users and survive — that is the point.
  userId     String   @map("user_id")
  // "canyon" | "tripLog" | "media" | "canyonShare" | "friendship" | "waypoint"
  // | "route"
  entityType String   @map("entity_type")
  entityId   String   @map("entity_id")
  deletedAt  DateTime @default(now()) @map("deleted_at")
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, deletedAt])
  @@map("sync_tombstones")
}

// Push-notification device registrations (Stage 3 mobile). One row per Expo
// push token; a token moves between users on re-login (upsert reassigns).
// Pruned when Expo reports DeviceNotRegistered.
model DeviceToken {
  id         String   @id @default(uuid())
  userId     String   @map("user_id")
  token      String   @unique
  platform   String
  createdAt  DateTime @default(now()) @map("created_at")
  lastSeenAt DateTime @default(now()) @map("last_seen_at")
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("device_tokens")
}

// Direct, per-item sharing for the things that are not canyons: waypoints,
// routes, LiDAR topo jobs, GeoPDF jobs. A row is a LIVE, REVOCABLE view of a
// record the sender still owns — contrast FileSend below, which hands over a
// copy and cannot be taken back.
//
// Canyons keep CanyonShare rather than folding in here: that table is
// load-bearing in delta sync, notifications and the tombstone builders, and
// migrating the one share path that already works buys nothing.
//
// THE ACCESS DECISION FOR A ROW HERE IS MADE ONLY IN
// api/src/lib/shareAccess.ts, which unions these rows with the visibility a
// waypoint or route already inherits from a shared canyon. Two sources of
// visibility read in two places is exactly how SEC-001 happened.
//
// NO FOREIGN KEY to the shared entity — entityType is polymorphic, so Postgres
// cannot cascade. Every hard-delete of a sharable entity must delete its Share
// rows in the same transaction (see deleteSharesFor in lib/shareAccess.ts);
// the guard is shareAccess.unit.test.ts.
model Share {
  id           String   @id @default(uuid())
  // One of SHARABLE_ENTITY_TYPES (shared/src/sharing.ts), validated at the
  // route. Not a Postgres enum: the vocabulary is read by the API and both
  // clients, and the TS union is the copy all three already share.
  entityType   String   @map("entity_type")
  entityId     String   @map("entity_id")
  sharedById   String   @map("shared_by_id")
  sharedWithId String   @map("shared_with_id")
  createdAt    DateTime @default(now()) @map("created_at")
  sharedBy     User     @relation("directSharedBy", fields: [sharedById], references: [id], onDelete: Cascade)
  sharedWith   User     @relation("directSharedWith", fields: [sharedWithId], references: [id], onDelete: Cascade)

  // One share per (thing, recipient): a repeat POST is a 409, not a second row.
  @@unique([entityType, entityId, sharedWithId])
  // "What of this type is shared with me" — the recipient's list/delta query.
  @@index([sharedWithId, entityType])
  // "Who can see this" — the owner's recipient list, and revoke-all on delete.
  @@index([entityType, entityId])
  @@map("shares")
}

// A file handed to friends as a COPY: an imported GPX/KML/GeoJSON, or a
// recorded track serialised to GPX at send time. NOT a share — once the
// recipient accepts, the file is theirs, editable, permanent, and there is no
// live link back. The UI says "Send a copy" for precisely this reason.
//
// One row here per SEND (one S3 object, charged to the sender's quota once,
// however many recipients); one FileSendRecipient row per person.
//
// Nothing deletes the object early. Accept and decline move a recipient row to
// a terminal status and no more: deleting the bytes when the first person
// responds strands every other recipient of the same send. The object expires
// by S3 lifecycle rule on the prefix, and the reaper sweeps these rows and
// refunds the sender's quota.
model FileSend {
  id         String              @id @default(uuid())
  senderId   String              @map("sender_id")
  // One of FILE_SEND_SOURCE_KINDS — "import" | "track". Feeds the recipient's
  // provenance line and nothing else.
  sourceKind String              @map("source_kind")
  // Display name shown to the recipient before they accept. The one
  // user-supplied string on a send: length-capped at the route, never logged.
  filename   String
  s3Key      String              @map("s3_key")
  sizeBytes  BigInt              @map("size_bytes")
  createdAt  DateTime            @default(now()) @map("created_at")
  // Must stay <= the S3 lifecycle rule's expiry, or a row outlives its bytes
  // and offers the recipient a download that 404s (FILE_SEND_TTL_DAYS).
  expiresAt  DateTime            @map("expires_at")
  sender     User                @relation(fields: [senderId], references: [id], onDelete: Cascade)
  recipients FileSendRecipient[]

  @@index([senderId])
  // The reaper's sweep.
  @@index([expiresAt])
  @@map("file_sends")
}

// One recipient of one send.
//
// THE DOWNLOAD GATE READS THIS ROW, never the S3 object's existence: one
// object serves every recipient, so "declined" has to be a fact about the
// person rather than about the bytes.
model FileSendRecipient {
  id          String    @id @default(uuid())
  fileSendId  String    @map("file_send_id")
  userId      String    @map("user_id")
  // One of FILE_SEND_STATUSES — "pending" | "accepted" | "declined".
  status      String    @default("pending")
  respondedAt DateTime? @map("responded_at")
  fileSend    FileSend  @relation(fields: [fileSendId], references: [id], onDelete: Cascade)
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([fileSendId, userId])
  @@index([userId, status])
  @@map("file_send_recipients")
}
