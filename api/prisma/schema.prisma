generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "debian-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
}

model User {
  id                  String         @id @default(uuid())
  cognitoId           String         @unique @map("cognito_id")
  username            String         @unique
  email               String         @unique
  uiPreferences       Json           @default("{}") @map("ui_preferences")
  vectorStyle         Json?          @map("vector_style")
  storageUsedBytes    BigInt         @default(0) @map("storage_used_bytes")
  storageQuotaBytes   BigInt         @default(5368709120) @map("storage_quota_bytes")
  weeklyTileQuota     Int            @default(100) @map("weekly_tile_quota")
  consentedAt         DateTime?      @map("consented_at")
  consentVersion      String?        @map("consent_version")
  createdAt           DateTime       @default(now()) @map("created_at")
  sharedBy            CanyonShare[]  @relation("sharedBy")
  sharedWith          CanyonShare[]  @relation("sharedWith")
  canyons             Canyon[]
  receivedFriendships Friendship[]   @relation("addressee")
  sentFriendships     Friendship[]   @relation("requester")
  media               Media[]
  notifications       Notification[]
  topoJobs            TopoJob[]
  topoExportJobs      TopoExportJob[]
  tripLogs            TripLog[]
  geoPdfTemplates     GeoPdfTemplate[]
  topoTemplates       TopoTemplate[]

  @@map("users")
}

model Canyon {
  id               String        @id @default(uuid())
  ownerId          String        @map("owner_id")
  name             String
  altNames         String[]      @default([])
  latitude         Float
  longitude        Float
  numAbseils       Int?          @map("num_abseils")
  longestAbseil    Float?        @map("longest_abseil_m")
  notes            String?
  attributes       Json          @default("{}")
  createdAt        DateTime      @default(now()) @map("created_at")
  updatedAt        DateTime      @updatedAt @map("updated_at")
  forkedFromId     String?       @map("forked_from_id")
  ropeWikiId       Int?          @map("ropewiki_id")
  ropeWikiSnapshot Json?         @map("ropewiki_snapshot")
  vGrade           Int?          @map("v_grade")
  aGrade           Int?          @map("a_grade")
  commitment       Int?
  quality          Int?
  wetsuits         Int?
  hours            Float?
  shares           CanyonShare[]
  forkedFrom       Canyon?       @relation("CanyonForks", fields: [forkedFromId], references: [id], onDelete: SetNull)
  forks            Canyon[]      @relation("CanyonForks")
  owner            User          @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  tripLogs         TripLog[]

  @@unique([ownerId, ropeWikiId])
  @@index([ownerId])
  @@map("canyons")
}

model Notification {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  type      String
  payload   Json
  read      Boolean  @default(false)
  createdAt DateTime @default(now()) @map("created_at")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("notifications")
}

model TripLog {
  id           String   @id @default(uuid())
  canyonId     String   @map("canyon_id")
  userId       String   @map("user_id")
  date         DateTime
  notes        String?
  customFields Json     @default("{}") @map("custom_fields")
  createdAt    DateTime @default(now()) @map("created_at")
  canyon       Canyon   @relation(fields: [canyonId], references: [id], onDelete: Cascade)
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([canyonId])
  @@index([userId])
  @@map("trip_logs")
}

model Media {
  id             String   @id @default(uuid())
  ownerId        String   @map("owner_id")
  // Polymorphic link to a Canyon or TripLog. Deliberately NO database foreign
  // key on linkedId: a single column cannot FK two tables (the previous schema
  // declared FKs to both canyons and trip_logs, which made every insert fail).
  // Integrity is enforced in the route layer (ownership checks on attach) and
  // cleaned up explicitly on canyon/trip/account deletion.
  linkedType     String   @map("linked_type")
  linkedId       String   @map("linked_id")
  s3KeyThumbnail String?  @map("s3_key_thumbnail")
  s3KeyDisplay   String   @map("s3_key_display")
  mediaType      String   @map("media_type")
  filename       String
  fileSizeBytes  BigInt   @map("file_size_bytes")
  createdAt      DateTime @default(now()) @map("created_at")
  owner          User     @relation(fields: [ownerId], references: [id], onDelete: Cascade)

  @@index([ownerId])
  @@index([linkedType, linkedId])
  @@map("media")
}

model Friendship {
  id          String   @id @default(uuid())
  requesterId String   @map("requester_id")
  addresseeId String   @map("addressee_id")
  status      String   @default("pending")
  createdAt   DateTime @default(now()) @map("created_at")
  addressee   User     @relation("addressee", fields: [addresseeId], references: [id], onDelete: Cascade)
  requester   User     @relation("requester", fields: [requesterId], references: [id], onDelete: Cascade)

  @@unique([requesterId, addresseeId])
  @@index([addresseeId])
  @@map("friendships")
}

model CanyonShare {
  id           String   @id @default(uuid())
  canyonId     String   @map("canyon_id")
  sharedById   String   @map("shared_by_id")
  sharedWithId String   @map("shared_with_id")
  createdAt    DateTime @default(now()) @map("created_at")
  canyon       Canyon   @relation(fields: [canyonId], references: [id], onDelete: Cascade)
  sharedBy     User     @relation("sharedBy", fields: [sharedById], references: [id], onDelete: Cascade)
  sharedWith   User     @relation("sharedWith", fields: [sharedWithId], references: [id], onDelete: Cascade)

  @@index([canyonId])
  @@index([sharedWithId])
  @@index([sharedById])
  @@map("canyon_shares")
}

model TopoJob {
  id            String   @id @default(uuid())
  userId        String   @map("user_id")
  status        String   @default("uploading")
  // status values: uploading | pending | processing | complete | failed
  name          String?
  footprint     Json?
  tileCount     Int?     @map("tile_count")
  estimatedSeconds Int?  @map("estimated_seconds")
  layerOptions  Json?    @map("layer_options")
  vectorStyleSnapshot Json? @map("vector_style_snapshot")
  s3InputKey    String?  @map("s3_input_key")
  s3OutputKeys  Json?    @map("s3_output_keys")
  // s3OutputKeys shape: { name: string, cogKey: string|null, pmtilesKey: string|null }[]
  // Raster layers (hillshade/vegetation/slope): cogKey set, pmtilesKey set (for in-app display).
  // Vector layers (contours/features): cogKey null, pmtilesKey set.
  // Composite + downloadable formats are produced on-demand by the export worker.
  outputBytes   BigInt?  @map("output_bytes")
  errorMessage  String?  @map("error_message")
  // Set when the worker transitions the job to "processing". Distinguishes a
  // stale-stuck job from one that simply hasn't been picked up yet, so the
  // reaper can apply a separate (longer) timeout to actively-running jobs.
  startedAt     DateTime? @map("started_at")
  // Number of times /start has launched this job (currently at most 1 — the
  // status guard means a job can never re-enter /start; kept for forensics
  // and a possible future bounded re-launch).
  attemptCount  Int      @default(0) @map("attempt_count")
  // ARN of the Fargate task launched for this job (Design L2). Lets the
  // reaper and DELETE handler issue a best-effort ECS StopTask instead of
  // letting an orphaned task run to completion. Null until RunTask succeeds.
  ecsTaskArn    String?  @map("ecs_task_arn")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([status])
  @@map("topo_jobs")
}

// On-demand export pipeline (Stage 2). One row per user-requested export of
// one (or more, future) completed TopoJob into a downloadable artefact. ECS
// task `logjam-topo-export-worker` consumes the row, produces the artefact,
// uploads it to s3://BUCKET/exports/{id}/{filename}, updates status, and
// emails the user. Replaces job-time composite MBTiles + stored MBTiles.
model TopoExportJob {
  id                  String    @id @default(uuid())
  userId              String    @map("user_id")
  sourceJobIds        String[]  @map("source_job_ids")
  // Single-element array for now; multi-job composites are a Stage 3 stretch.
  layers              String[]
  // Subset of TopoLayerKey (hillshade/vegetation/slope/contours/features).
  format              String
  // "mbtiles" | "geotiff" | "gpkg" | "geojson" | "gpx" (kmz deferred)
  bundling            String
  // "composite" | "per-layer"
  vectorStyleSnapshot Json      @map("vector_style_snapshot")
  status              String    @default("queued")
  // queued | running | completed | failed
  resultKey           String?   @map("result_key")
  resultBytes         BigInt?   @map("result_bytes")
  errorMessage        String?   @map("error_message")
  // Set when the export worker transitions the row to "running" — anchors the
  // reaper's running-timeout (mirrors topo_jobs.started_at).
  startedAt           DateTime? @map("started_at")
  // ARN of the Fargate task launched for this export (Design L2) — see
  // TopoJob.ecsTaskArn.
  ecsTaskArn          String?   @map("ecs_task_arn")
  createdAt           DateTime  @default(now()) @map("created_at")
  completedAt         DateTime? @map("completed_at")
  user                User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@map("topo_export_jobs")
}

model GeoPdfTemplate {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  name      String
  config    Json
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("geo_pdf_templates")
}

model TopoTemplate {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  name      String
  config    Json
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("topo_templates")
}
