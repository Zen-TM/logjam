# The API's complete non-secret environment on the brain: the values
# api/.ebextensions/*.config set on Elastic Beanstalk, then the brain's own
# (last block). The release pointer carries this file's content
# (host/release-agent.sh writes it to /etc/brain/api.env, then adds
# LOGJAM_RUNTIME=prod itself, so it is not here).
# Guard: api/src/brainEnvironment.unit.test.ts.
NODE_ENV=production
PORT=8080
AUTH_MODE=oidc
OIDC_ISSUER=https://cognito-idp.ap-southeast-2.amazonaws.com/ap-southeast-2_x5zPhJXMk
OIDC_AUDIENCE=545ofbb8l9d1sl6ggbmk6oonn9
CORS_ORIGIN=https://logjamnsw.com,https://www.logjamnsw.com
S3_BUCKET_MEDIA=logjam-media
S3_BUCKET_TOPO=logjam-topo-jobs
TOPO_CDN_BASE_URL=https://logjamnsw.com
ECS_CLUSTER=logjam-cluster
ECS_TOPO_TASK_DEF=logjam-topo-worker
ECS_SUBNETS=subnet-0f59b0845905891be,subnet-0c10e1438a8fd0231
ECS_SECURITY_GROUPS=sg-0bd5e6621b5f3ec4b
DB_PORT=5432
DB_NAME=logjam
DB_SECRET_ID=logjam/app-db-password
S3_BUCKET_ACCESS_LOGS=logjam-access-logs-620853681701
EGRESS_API_REQUESTER_PATTERN=assumed-role/logjam-brain/
EMAIL_FROM=noreply@notifications.logjamnsw.com
FRONTEND_URL=https://logjamnsw.com/
RESEND_SECRET_ID=logjam/resend-api-key
SMTP_HOST=smtp.resend.com
SMTP_PORT=465
SMTP_USER=resend
ORIGIN_VERIFY_SECRET_ID=logjam/origin-verify
ORIGIN_VERIFY_ENFORCE=true

# What differs from Elastic Beanstalk: Postgres is the Compose service of that
# name, verified against its own certificate, behind one CloudFront hop.
DB_HOST=postgres
DATABASE_SSL_CA=/app/brain-ca.pem
TRUST_PROXY_HOPS=1
