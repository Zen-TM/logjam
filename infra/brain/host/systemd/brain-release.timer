[Unit]
Description=Make the API match the release pointer, on a timer
# After, not Requires: boot.sh can fail late (an S3 blip) with the database fine, and Requires= would keep the API down for it.
After=brain-boot.service

[Timer]
OnBootSec=30s
OnUnitActiveSec=30s
AccuracySec=1s

[Install]
WantedBy=timers.target
