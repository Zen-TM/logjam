{
  "name": "cognito-email-sender",
  "version": "1.0.0",
  "private": true,
  "description": "Cognito CustomEmailSender Lambda — sends verification codes via Resend",
  "type": "module",
  "scripts": {
    "build": "node build.mjs",
    "typecheck": "tsc --noEmit",
    "test": "esbuild src/decrypt.test.ts --bundle --platform=node --format=cjs --external:@aws-sdk/* --outfile=.test-out/decrypt.test.cjs --log-level=warning && node --test .test-out/decrypt.test.cjs"
  },
  "dependencies": {
    "@aws-crypto/client-node": "^5.0.2",
    "resend": "^6.30.0"
  },
  "devDependencies": {
    "@aws-sdk/client-secrets-manager": "^3.1142.0",
    "@types/aws-lambda": "^8.10.164",
    "@types/node": "^22.20.5",
    "esbuild": "^0.28.2",
    "typescript": "^7.0.2"
  }
}
