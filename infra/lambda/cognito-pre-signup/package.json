{
  "name": "cognito-pre-signup",
  "version": "1.0.0",
  "private": true,
  "description": "Cognito pre sign-up Lambda: a monthly cap on new accounts",
  "type": "module",
  "scripts": {
    "build": "node build.mjs",
    "typecheck": "tsc --noEmit",
    "test": "esbuild src/index.test.ts --bundle --platform=node --format=cjs --external:@aws-sdk/* --outfile=.test-out/index.test.cjs --log-level=warning && node --test .test-out/index.test.cjs"
  },
  "devDependencies": {
    "@aws-sdk/client-dynamodb": "^3.1160.0",
    "@types/aws-lambda": "^8.10.164",
    "@types/node": "^22.20.5",
    "esbuild": "^0.28.2",
    "typescript": "^7.0.2"
  }
}
